<mxfile host="app.diagrams.net">
  <diagram name="eventhub-protobuf-schema-id">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Native Protobuf from Azure Event Hubs, schema-tagged into Confluent Cloud" style="text;html=1;align=center;fontStyle=1;fontSize=19;fontColor=#14181c;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="850" height="30" as="geometry"/>
