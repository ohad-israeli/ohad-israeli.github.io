        <mxCell id="caption" value="A custom SMT schema-tags each record by embedding its Protobuf schema ID directly in the payload (not a header) and routes it to the matching topic -- no changes to the producer." style="text;html=1;align=center;fontColor=#57606a;fontSize=11;" vertex="1" parent="1">
